#!/bin/sh
# nfsroot-watchdog-arm -- stage the watchdog into /run at boot.
#
# Runs once per boot, while the NFS root is still consistent with what this
# machine booted. Copies a static busybox, the check script and the resolved
# configuration into /run (tmpfs, never paged back out to NFS), and records
# what the root looked like at boot: the server's generation marker and which
# probe files exist. From then on nfsroot-watchdog.service runs only from
# /run. See nfsroot-watchdog-check for the whole story.

set -eu

STATE=${NFSROOT_WATCHDOG_STATE:-/run/nfsroot-watchdog}
LIBDIR=${NFSROOT_WATCHDOG_LIBDIR:-/usr/lib/nfsroot-watchdog}
CONFIG=${NFSROOT_WATCHDOG_CONFIG:-/etc/default/nfsroot-watchdog}
MOUNTS=${NFSROOT_WATCHDOG_MOUNTS:-/proc/mounts}
BUSYBOX=${NFSROOT_WATCHDOG_BUSYBOX:-/bin/busybox}

# Everything the check script reads from its config.
VARS="LOWER ROOT GEN_FILE LOCK_FILE FLEET_INHIBIT INHIBIT PROBES QUIET_DIRS
HOSTNAME_FILE KMSG SYSTEMCTL SYSTEMD_SHUTDOWN SLOT SLOT_SED SLOT_STRIDE
SLOT_BASE SLOTS SPACING JITTER BASE_DELAY WARN_BEFORE CHECK_INTERVAL CONSOLE
DEV_DIR CONFIRM QUIET LOCK_MAX_AGE USER_GRACE DRY_RUN"

# Every applet the check script calls. Nothing else is on its PATH, so a
# missing one fails loudly here rather than silently falling back to the root.
APPLETS="sh cat cut date grep head md5sum reboot rm sed stat sync timeout touch wc who"

# Under set -e a failure ends the script with only the failing command's own
# message, in the journal. Say which step failed, in the journal and in the
# kernel log, which reaches the console (and netconsole) even when nobody can
# read the journal.
step=start
on_exit() {
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "nfsroot-watchdog-arm: FAILED (exit $rc) at step: $step" >&2
		echo "nfsroot-watchdog-arm: FAILED (exit $rc) at step: $step" >>"${KMSG:-/dev/kmsg}" || true
	fi
}
trap on_exit EXIT

# Whatever happens below, never leave a previous boot's (or run's) check
# script where nfsroot-watchdog.service would run it.
rm -f "$STATE/check"

step="read $LIBDIR/defaults and $CONFIG"
# shellcheck source=/dev/null
. "$LIBDIR/defaults"
if [ -e "$CONFIG" ]; then
	# shellcheck source=/dev/null
	. "$CONFIG"
fi

if [ "$ENABLED" != 1 ]; then
	echo "disabled (ENABLED=$ENABLED in $CONFIG)"
	exit 0
fi

# fstype of the mount at $1, from /proc/mounts
fstype_at() {
	while read -r _dev mnt type _rest; do
		if [ "$mnt" = "$1" ]; then
			fs=$type
		fi
	done <"$MOUNTS"
	echo "${fs:-}"
	fs=
}

step="find the NFS root in $MOUNTS"
if [ "$LOWER" = auto ]; then
	case $(fstype_at /media/root-ro) in
	nfs | nfs4) LOWER=/media/root-ro ;;
	*)
		case $(fstype_at /) in
		nfs | nfs4) LOWER= ;;
		*)
			echo "not an NFS root (no NFS mount at /media/root-ro or /), nothing to watch"
			exit 0
			;;
		esac
		;;
	esac
fi
case " $PROBES " in
*" $GEN_FILE "*) ;;
*) PROBES="$PROBES $GEN_FILE" ;;
esac

# /run itself is no place to execute from: Debian's initramfs-tools mounts
# it noexec (and systemd keeps that mount), which is exactly how every
# initramfs-booted NFS root starts. So the watchdog gets its own small tmpfs
# at $STATE, without noexec. Only root can mount; unprivileged runs (and the
# tests, which set NFSROOT_WATCHDOG_MOUNT=no even as root) stage into a plain
# directory.
step="set up $STATE"
if [ "${NFSROOT_WATCHDOG_MOUNT:-auto}" != no ] && [ "$(id -u)" = 0 ]; then
	mkdir -p "$STATE"
	if ! mountpoint -q "$STATE"; then
		mount -t tmpfs -o mode=0755,nosuid,nodev,size=16m nfsroot-watchdog "$STATE"
	fi
	find "$STATE" -mindepth 1 -delete
else
	rm -rf "$STATE"
	mkdir -p "$STATE"
fi

step="stage $BUSYBOX into $STATE/bin"
mkdir -p "$STATE/bin"
cp "$BUSYBOX" "$STATE/bin/busybox"
if ! "$STATE/bin/busybox" true; then
	echo "cannot execute $STATE/bin/busybox (is $STATE on a noexec mount?)" >&2
	exit 1
fi
for a in $APPLETS; do
	"$STATE/bin/busybox" --list | grep -qxF -e "$a" || {
		echo "busybox at $BUSYBOX has no '$a' applet" >&2
		exit 1
	}
	ln -s busybox "$STATE/bin/$a"
done

step="write $STATE/config"
# The resolved configuration, one single-quoted assignment per variable.
for v in $VARS; do
	eval "val=\${$v}"
	# shellcheck disable=SC2154 # assigned by the eval
	printf "%s='%s'\n" "$v" "$(printf '%s' "$val" | sed "s/'/'\\\\''/g")"
done >"$STATE/config"

step="record the boot generation from $LOWER$GEN_FILE"
if [ -e "$LOWER$GEN_FILE" ]; then
	head -n 1 "$LOWER$GEN_FILE" >"$STATE/boot-generation"
else
	echo none >"$STATE/boot-generation"
fi

step="record which probes exist"
# stat also primes the overlay's dentry cache, which is what later turns a
# replaced file into ESTALE rather than a silent switch to the new copy.
: >"$STATE/probes-present"
for p in $PROBES; do
	if stat "$ROOT$p" >/dev/null; then
		echo "$p" >>"$STATE/probes-present"
	fi
done

step="stage the check script"
# Last: its presence is what lets nfsroot-watchdog.service run.
cp "$LIBDIR/nfsroot-watchdog-check" "$STATE/check"

step="report"
echo "armed: NFS root at '${LOWER:-/}', generation '$(cat "$STATE/boot-generation")'," \
	"slot $("$STATE/bin/sh" "$STATE/check" slot "$(cat "$HOSTNAME_FILE")")," \
	"probes: $(tr '\n' ' ' <"$STATE/probes-present")"
